{
  "id": "/",
  "name": "JulOS",
  "short_name": "JulOS",
  "description": "JulOS — a browser-native desktop for your homelab.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#1f6feb",
