{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "SessionTimeoutMinutes": 30,
    "LockoutMinutes": 15,
    "MaximumFailedAccessAttempts": 5,
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60
  }
}
