{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "postgresql"
  },
  "Authentication": {
    "SessionTimeoutMinutes": 30,
    "LockoutMinutes": 15,
    "MaximumFailedAccessAttempts": 5,
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60
  },
  "Secrets": {
    "ActiveKeyId": "primary",
    "KeyRingPath": "/run/julos-secret-keys",
    "LeaseLifetimeSeconds": 300
  }
}
