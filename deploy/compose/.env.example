# Copy to .env and set the required values before starting the development stack.
# .env and secret-keys/ are ignored by git. Never commit real credentials or keys.

# Required. The stack refuses to start without it.
JULOS_POSTGRES_PASSWORD=

# Required absolute or compose-relative host directory containing primary.key.
JULOS_SECRET_KEY_RING_PATH=./secret-keys

# Optional overrides.
JULOS_POSTGRES_DB=julos
JULOS_POSTGRES_USER=julos
JULOS_SERVER_PORT=8080

# Optional Remote display transport. Set both values together to enable it.
# The provider template must contain exactly one {runtimeId} placeholder, and
# must match how Docker names Runtime-Manager-created containers:
# ws://julos-{runtimeId}:8081/
JULOS_REMOTE_DISPLAY_PROVIDER_ENDPOINT_TEMPLATE=
JULOS_REMOTE_DISPLAY_PUBLIC_ORIGIN=
JULOS_REMOTE_DISPLAY_GRANT_LIFETIME_SECONDS=60

# Optional Remote sessions (RDP/VNC/SSH), see docs/REMOTE-PROVIDER-RUNTIME.md.
# Layer in compose.remote.yaml and the runtime-manager service:
#   docker compose -f compose.yaml -f compose.remote.yaml --profile remote up --build
# Generate JULOS_RUNTIME_MANAGER_KEY and JULOS_REMOTE_PROVIDER_CALLBACK_KEY with:
#   openssl rand -hex 32
JULOS_RUNTIME_MANAGER_KEY=
JULOS_REMOTE_RUNTIME_MANAGER_ENDPOINT=http://runtime-manager:8081/
JULOS_REMOTE_PROVIDER_CALLBACK_ENDPOINT=http://server:8080/api/v1/internal/remote/provider-events
JULOS_REMOTE_PROVIDER_CALLBACK_KEY=
JULOS_REMOTE_RUNTIME_NETWORK=julos-remote

# One example provider. Protocol must be exactly one of rdp, vnc, ssh; Image
# must be a digest-pinned reference (repository@sha256:...) to a published
# packages/JulOS.Remote/runtime image.
JULOS_REMOTE_PROVIDER_0_PROTOCOL=ssh
JULOS_REMOTE_PROVIDER_0_PACKAGE_ID=de.juloc.julos.remote-provider
JULOS_REMOTE_PROVIDER_0_PACKAGE_VERSION=1.0.0
JULOS_REMOTE_PROVIDER_0_IMAGE=
JULOS_REMOTE_PROVIDER_0_MEMORY_MB=512
JULOS_REMOTE_PROVIDER_0_CPU_LIMIT=1
JULOS_REMOTE_PROVIDER_0_PIDS_LIMIT=256

# One example network profile. Generate JULOS_REMOTE_NETWORK_PROFILE_ID with:
#   node -e "console.log(crypto.randomUUID())"
# AllowedTargetPattern accepts one exact host, *.suffix or dns-label-* prefix.
JULOS_REMOTE_NETWORK_PROFILE_ID=
JULOS_REMOTE_ALLOWED_TARGET_PATTERN=
JULOS_REMOTE_ALLOWED_PORT=0
