# Copy to .env and set the required values before starting the development stack.
# .env and secret-keys/ are ignored by git. Never commit real credentials or keys.

# Required. The stack refuses to start without it.
JULOS_POSTGRES_PASSWORD=

# Required absolute or compose-relative host directory containing primary.key.
JULOS_SECRET_KEY_RING_PATH=./secret-keys

# Optional overrides.
JULOS_POSTGRES_DB=julos
JULOS_POSTGRES_USER=julos
JULOS_SERVER_PORT=8080
