# JulOS 0.4.0-beta.19 evaluation configuration.
# Copy this file to .env. Never commit .env.

JULOS_SERVER_IMAGE=ghcr.io/juloc/julos-server:0.4.0-beta.19

# Required. Generate with: openssl rand -hex 32
JULOS_POSTGRES_PASSWORD=

# Required. Generate with: openssl rand -base64 32
JULOS_PRIMARY_KEY=

# The alpha binds to loopback by default. Change deliberately only when an
# authenticated reverse proxy or trusted private network protects the server.
JULOS_BIND_ADDRESS=127.0.0.1
JULOS_SERVER_PORT=8080

JULOS_POSTGRES_DB=julos
JULOS_POSTGRES_USER=julos

# Optional Remote display transport. Set template and origin together.
JULOS_REMOTE_DISPLAY_PROVIDER_ENDPOINT_TEMPLATE=
JULOS_REMOTE_DISPLAY_PUBLIC_ORIGIN=
JULOS_REMOTE_DISPLAY_GRANT_LIFETIME_SECONDS=60
