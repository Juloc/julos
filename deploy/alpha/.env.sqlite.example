# JulOS 0.4.0-beta.25 single-service evaluation configuration.
# Copy this file to .env. Never commit .env.

JULOS_SERVER_IMAGE=ghcr.io/juloc/julos-server:0.4.0-beta.25

# Required. Generate with: openssl rand -base64 32
JULOS_PRIMARY_KEY=

# Loopback is the safe default. Change only behind an authenticated reverse proxy
# or on a trusted private network.
JULOS_BIND_ADDRESS=127.0.0.1
JULOS_SERVER_PORT=8080

# Optional Remote display transport. Set template and origin together.
JULOS_REMOTE_DISPLAY_PROVIDER_ENDPOINT_TEMPLATE=
JULOS_REMOTE_DISPLAY_PUBLIC_ORIGIN=
JULOS_REMOTE_DISPLAY_GRANT_LIFETIME_SECONDS=60
