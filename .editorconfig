root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Git and EditorConfig metadata is parsed by tools that do not all tolerate a byte order mark.
[{.gitattributes,.gitignore,.editorconfig}]
charset = utf-8

# npm rewrites these files itself and preserves neither a byte order mark nor CRLF.
[{package.json,package-lock.json}]
charset = utf-8
end_of_line = lf

[*.{sh,bash}]
charset = utf-8
end_of_line = lf

[Dockerfile]
charset = utf-8
end_of_line = lf

[Dockerfile.*]
charset = utf-8
end_of_line = lf

[*.{yml,yaml}]
charset = utf-8
end_of_line = lf

[*.json]
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

# EF migration bodies are generated code. The generator emits small inline arrays
# for indexes and constraints; CA1861 is not actionable at this boundary.
[src/JulOS.Infrastructure/Persistence/Core/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = none

[*.{ts,tsx,js,jsx,mjs,cjs,css,scss,html}]
indent_style = space
indent_size = 2
