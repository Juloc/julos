root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
charset = utf-8
end_of_line = lf

[Dockerfile]
charset = utf-8
end_of_line = lf

[Dockerfile.*]
charset = utf-8
end_of_line = lf

[*.{yml,yaml}]
charset = utf-8
end_of_line = lf

[*.json]
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,css,scss,html}]
indent_style = space
indent_size = 2
