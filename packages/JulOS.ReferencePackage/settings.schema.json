{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os.juloc.de/packages/reference/settings.schema.json",
  "title": "JulOS Reference Package Settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "message": {
      "type": "string",
      "maxLength": 256,
      "default": "Reference package is running."
    },
    "faultMode": {
      "type": "boolean",
      "default": false,
      "description": "Enables the intentional health fault used to verify problem handling."
    }
  }
}
