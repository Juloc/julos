<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Shared JulOS Remote transport primitives and Guacamole launch encoding.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>JulOS.Remote.Transport</PackageId>
    <PackageTags>julos;remote;guacamole;transport</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
