{
  "SchemaVersion": "1",
  "PackageId": "de.juloc.julos.browser",
  "ImageRepository": "ghcr.io/juloc/julos-browser-runtime",
  "ImageReferenceFormat": "ghcr.io/juloc/julos-browser-runtime:{version}@sha256:{digest}",
  "NetworkPolicy": "configured-isolated",
  "DisplayProtocol": "vnc",
  "DisplayPort": 5900,
  "Limits": {
    "MemoryMegabytes": 1024,
    "CpuLimit": 2.0,
    "PidsLimit": 256
  },
  "Environment": {
    "JULOS_START_URL": "about:blank"
  },
  "RequiredSecretEnvironment": [
    "JULOS_VNC_PASSWORD"
  ]
}
