* text=auto

*.md text eol=crlf
*.txt text eol=crlf
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.json text eol=crlf
package.json text eol=lf
package-lock.json text eol=lf
*.ts text eol=crlf
*.tsx text eol=crlf
*.js text eol=crlf
*.jsx text eol=crlf
*.mjs text eol=crlf
*.cjs text eol=crlf
*.css text eol=crlf
*.scss text eol=crlf
*.html text eol=crlf
*.ps1 text eol=crlf

*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
.dockerignore text eol=lf
*.env text eol=lf
.env.example text eol=lf

# Generated SQLite migration scripts are embedded verbatim at build time, so their
# bytes must not depend on the platform they were checked out on. They are not JulOS
# repository prose, so the D012 byte-order-mark rule does not apply to them.
*.sql text eol=lf

# SQLite upgrade fixtures are database files, never text.
*.db binary

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.pdf binary
