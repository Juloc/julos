{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juloc.de/schemas/app-manifest.v1.schema.json",
  "title": "JulOS application manifest, version 1",
  "description": "One application version and its delivery options. Unknown ordinary fields fail validation; unknown keys beginning with x- are preserved as inert metadata and are never executed. The manifest is authoritative for AppId: Compose metadata cannot override it.",
  "type": "object",
  "required": ["schema", "appId", "version", "name", "description", "architectures", "deliveryOptions"],
  "properties": {
    "schema": { "type": "string", "const": "app-manifest.v1" },
    "appId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "name": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "icon": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/bundlePath" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^linux/(amd64|arm64|arm/v7|386|ppc64le|s390x)$" }
    },
    "deliveryOptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/deliveryOption" }
    },
    "requiredFeatures": {
      "description": "Extension features whose absence makes this entry incompatible. An unsupported required feature fails before preview.",
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" }
    },
    "releaseNotes": { "$ref": "#/$defs/localizedText" },
    "screenshots": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/bundlePath" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homepage": { "$ref": "#/$defs/httpsUrl" },
        "source": { "$ref": "#/$defs/httpsUrl" },
        "support": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "categories": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
    },
    "searchTerms": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "minimumEngine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "docker": { "type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$" },
        "compose": { "type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$" }
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/parameter" }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spdx": { "type": "string", "minLength": 1, "maxLength": 64 },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "extensionPackages": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageId", "version"],
        "properties": {
          "packageId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$" },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "migrationWarnings": { "$ref": "#/$defs/localizedText" }
  },
  "$defs": {
    "localizedText": {
      "description": "English is required; German is supported and expected for user-facing text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "de": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "bundlePath": {
      "description": "Relative to the version directory. Traversal, absolute paths and backslashes are rejected by the bundle validator.",
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
    },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]{1,2048}$" },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "required"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "type": { "type": "string", "enum": ["string", "integer", "boolean", "port", "path", "secret"] },
        "required": { "type": "boolean" },
        "default": { "type": ["string", "integer", "boolean", "null"] },
        "label": { "$ref": "#/$defs/localizedText" },
        "help": { "$ref": "#/$defs/localizedText" }
      }
    },
    "deliveryOption": {
      "type": "object",
      "required": ["key", "kind"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "kind": { "type": "string", "enum": ["connection", "docker-compose", "docker-image"] },
        "connectionKind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "endpointPolicy": { "type": "string", "enum": ["https-only", "https-or-private-http"] },
        "composePath": { "$ref": "#/$defs/bundlePath" },
        "composeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "image": { "type": "string", "minLength": 1, "maxLength": 512 },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "service": { "type": "string", "minLength": 1, "maxLength": 63 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "scheme": { "type": "string", "enum": ["http", "https"] },
            "path": { "type": "string", "pattern": "^/[^\\s]{0,255}$" }
          }
        }
      }
    }
  }
}
