{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os.juloc.de/schemas/package-manifest.v1.schema.json",
  "title": "JulOS Package Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "publisher",
    "version",
    "minimumCoreVersion",
    "maximumCoreVersion",
    "worker",
    "capabilitiesProvided",
    "capabilitiesRequired",
    "permissions",
    "applications",
    "widgets",
    "settings",
    "migrations",
    "runtimeProfiles",
    "dependencies"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
      "maxLength": 200
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "$ref": "#/$defs/semanticVersion" },
    "minimumCoreVersion": { "$ref": "#/$defs/semanticVersion" },
    "maximumCoreVersion": {
      "oneOf": [
        { "$ref": "#/$defs/semanticVersion" },
        { "type": "null" }
      ]
    },
    "worker": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "cpuLimit", "memoryLimitMb"],
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$"
            },
            "cpuLimit": { "type": "number", "exclusiveMinimum": 0, "maximum": 64 },
            "memoryLimitMb": { "type": "integer", "minimum": 16, "maximum": 262144 }
          }
        }
      ]
    },
    "capabilitiesProvided": {
      "type": "array",
      "items": { "$ref": "#/$defs/providedCapability" },
      "uniqueItems": true
    },
    "capabilitiesRequired": {
      "type": "array",
      "items": { "$ref": "#/$defs/requiredCapability" },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/dottedIdentifier" },
      "uniqueItems": true
    },
    "applications": {
      "type": "array",
      "items": { "$ref": "#/$defs/application" },
      "uniqueItems": true
    },
    "widgets": {
      "type": "array",
      "items": { "$ref": "#/$defs/widget" },
      "uniqueItems": true
    },
    "settings": { "type": "array", "items": { "type": "object" } },
    "migrations": { "type": "array", "items": { "type": "object" } },
    "runtimeProfiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/runtimeProfile" },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "dottedIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "maxLength": 200
    },
    "providedCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/dottedIdentifier" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "requiredCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "optional"],
      "properties": {
        "name": { "$ref": "#/$defs/dottedIdentifier" },
        "version": { "type": "integer", "minimum": 1 },
        "optional": { "type": "boolean" }
      }
    },
    "frontendComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "module",
        "integrity",
        "customElement",
        "localization",
        "contractVersion",
        "permissions"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/dottedIdentifier" },
        "module": { "type": "string", "pattern": "^frontend/.+\\.js$" },
        "integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/=]+$" },
        "customElement": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$" },
        "localization": { "type": "string", "pattern": "^frontend/.+\\.json$" },
        "contractVersion": { "type": "integer", "minimum": 1 },
        "permissions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dottedIdentifier" },
          "uniqueItems": true
        }
      }
    },
    "application": {
      "allOf": [
        { "$ref": "#/$defs/frontendComponent" },
        {
          "type": "object",
          "required": ["instancePolicy", "minimumWidth", "minimumHeight"],
          "properties": {
            "instancePolicy": {
              "enum": ["single-user", "single-target", "multiple"]
            },
            "minimumWidth": { "type": "integer", "minimum": 240 },
            "minimumHeight": { "type": "integer", "minimum": 160 }
          }
        }
      ]
    },
    "widget": {
      "allOf": [
        { "$ref": "#/$defs/frontendComponent" },
        {
          "type": "object",
          "required": ["sizes"],
          "properties": {
            "sizes": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["small", "medium", "wide", "large"] },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image", "networks", "volumes", "cpuLimit", "memoryLimitMb"],
      "properties": {
        "name": { "$ref": "#/$defs/dottedIdentifier" },
        "image": { "type": "string", "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$" },
        "networks": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "volumes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "cpuLimit": { "type": "number", "exclusiveMinimum": 0, "maximum": 64 },
        "memoryLimitMb": { "type": "integer", "minimum": 16, "maximum": 262144 }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minimumVersion", "optional"],
      "properties": {
        "id": { "$ref": "#/$defs/dottedIdentifier" },
        "minimumVersion": { "$ref": "#/$defs/semanticVersion" },
        "optional": { "type": "boolean" }
      }
    }
  }
}
